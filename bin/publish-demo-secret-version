#!/usr/bin/env bash
set -euo pipefail

project_id="${PROJECT_ID:-gke-sre-assesment}"
secret_id="${SECRET_ID:-gke-sre-response-demo-token}"

if [[ $# -ne 1 ]]; then
  echo "Usage: $0 /absolute/path/to/local-secret-file" >&2
  exit 64
fi

secret_file="$1"

if [[ ! -f "$secret_file" || ! -r "$secret_file" ]]; then
  echo "Secret file must exist and be readable: $secret_file" >&2
  exit 66
fi

gcloud secrets describe "$secret_id" --project="$project_id" >/dev/null
gcloud secrets versions add "$secret_id" --project="$project_id" --data-file="$secret_file" --quiet >/dev/null

echo "Added a new Secret Manager version to $secret_id in $project_id. The secret value was not printed."
